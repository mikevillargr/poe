# Copy to .env.local for development. Never commit real values.

# --- Database -------------------------------------------------------------
# Schema changes go through `npm run db:migrate` (never db:push on real data).
DATABASE_URL=postgresql://poe_user:your_password@localhost:5432/poe_db

# --- Auth (Auth.js / NextAuth v5, Google only) ----------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Public URL of the app. Google requires HTTPS for anything other than localhost.
AUTH_URL=http://localhost:3001
# Set to true behind a reverse proxy.
AUTH_TRUST_HOST=true
# Google Cloud OAuth client (Web application). Authorized redirect URI:
#   <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Only verified accounts on this Google Workspace domain can sign in; they start pending.
ALLOWED_EMAIL_DOMAIN=growth-rocket.com
# Bootstrapped as an active super admin on first sign-in.
SUPER_ADMIN_EMAIL=mike@growth-rocket.com

# --- AI providers ---------------------------------------------------------
# Encrypts provider keys entered in Settings (stored in ai_provider_credentials).
# Generate with: openssl rand -base64 32. Changing it makes stored keys unreadable.
APP_ENCRYPTION_KEY=
# Optional env fallbacks if no key is stored in Settings.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MOONSHOT_API_KEY=
# Optional default models per role ("provider:model") until Settings are saved.
# AI_DEFAULT_GENERATION=anthropic:claude-sonnet-5-5
# AI_DEFAULT_RESEARCH=anthropic:claude-sonnet-5-5
# Use the deterministic mock provider (no keys needed) for development.
AI_MOCK=0

# --- Google Docs export ---------------------------------------------------
# Uses AUTH_GOOGLE_ID (above) in the browser; needs the Drive API enabled in that Google Cloud project and
# the site listed under the OAuth client's "Authorized JavaScript origins". No API key.

# --- Files ----------------------------------------------------------------
UPLOADS_DIR=/app/uploads


# ==========================================================================
# PRODUCTION (/var/www/poe/.env on hostinger-vps). Read by docker-compose.yml
# both for ${...} interpolation and as the app/migrate env_file.
# Names only here; real values live on the server. See docs/deploy/CUTOVER.md.
# ==========================================================================
#
# --- Database (service `db`, never published) ---
# On the existing volume these MUST match the role/database that already exist.
# POSTGRES_DB=poe
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# Host is the compose service name `db`. URL-encode special chars in the password.
# DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@db:5432/poe
#
# --- Auth.js ---
# AUTH_SECRET=                      # openssl rand -base64 32
# AUTH_URL=https://poe.vill.ar
# AUTH_TRUST_HOST=true              # required behind Caddy
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=               # redirect URI: https://poe.vill.ar/api/auth/callback/google
# ALLOWED_EMAIL_DOMAIN=growth-rocket.com
# SUPER_ADMIN_EMAIL=mike@growth-rocket.com
#
# --- AI ---
# APP_ENCRYPTION_KEY=               # openssl rand -base64 32; never change once keys are stored
# ANTHROPIC_API_KEY=                # optional env fallbacks
# OPENAI_API_KEY=
# MOONSHOT_API_KEY=
# AI_MOCK=0
#
# --- Edge / build ---
# POE_DOMAIN=poe.vill.ar            # Caddy site address (optional, this is the default)
#
# Obsolete on the server after cutover (remove): DB_USER, DB_PASSWORD, NEXTAUTH_URL,
# NEXTAUTH_SECRET, NEXT_PUBLIC_APP_URL, NODE_ENV, PORT (compose sets NODE_ENV/PORT itself).
